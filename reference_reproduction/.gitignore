# Large artifacts for this comparison track. The root .gitignore covers *.bin,
# *.parquet and *.safetensors, but not e.g. a downloaded 8.6 MB tokenizer.json,
# so the whole directories are excluded here per CLAUDE.md's "if you're about to
# git add something over a few MB, stop" rule.
data/
models/

# Per-run score vectors and logits (regenerated by train.py / eval_shipped.py).
# The summary_*.json and window_recall.json files ARE tracked -- they hold the
# reported numbers with their CIs.
results/*.npy
