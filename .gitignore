# Python
__pycache__/
*.py[cod]
.venv/
.python-version
*.egg-info/

# Data and large artifacts — these live in Kaggle Datasets, not git
data/
wheels/
*.safetensors
*.bin
*.pt
*.ckpt
*.parquet
*.faiss
*.index

# Credentials
.env
.kaggle/
kaggle.json

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code agent worktrees (isolated checkouts, not project content)
.claude/

# Kaggle dataset upload staging areas: the payloads are uploaded to Kaggle
# Datasets and must not enter git. dataset-metadata.json is kept, since it
# documents exactly what was uploaded and under which slug.
notebooks/kaggle/*-data/*
!notebooks/kaggle/*-data/dataset-metadata.json
*.npy
*.whl
data/checkpoints/
